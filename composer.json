{
    "name": "bitrix24/mcp",
    "description": "Bitrix24 MCP Server",
    "type": "bitrix-module",
    "license": "MIT",
    "keywords": [
        "ai",
        "bitrix24",
        "mcp",
        "model-context-protocol"
    ],
    "authors": [
        {
            "name": "Bitrix24 Team",
            "email": "info@bitrix24.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "ext-curl": "*",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Bitrix24\\Mcp\\": "lib/"
        },
        "classmap": [
            "lib/Cloud/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Bitrix24\\Mcp\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "lint": "find lib cli public routes install include.php -name '*.php' -exec php -l {} +",
        "test": "@php vendor/bin/phpunit --testsuite Unit",
        "test:integration": "@php vendor/bin/phpunit --configuration=phpunit.integration.xml.dist --testsuite Integration",
        "phpstan": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist",
        "phpstan:bitrix": "@php vendor/bin/phpstan analyse --configuration=phpstan.bitrix.neon.dist",
        "phpcs": "@php vendor/bin/phpcs --standard=phpcs.xml.dist",
        "quality": [
            "@phpstan",
            "@phpcs"
        ],
        "ci": [
            "@lint",
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
