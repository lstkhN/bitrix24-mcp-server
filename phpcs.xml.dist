<?xml version="1.0"?>
<ruleset name="Bitrix24 MCP">
    <description>PHP coding standard for Bitrix24 MCP.</description>

    <rule ref="PSR12"/>

    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>

    <file>lib</file>
    <file>cli</file>
    <file>public</file>
    <file>routes</file>
    <file>install</file>
    <file>include.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
