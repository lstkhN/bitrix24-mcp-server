# Bitrix24 MCP Server — Environment Configuration
#
# This module stores configuration in the Bitrix24 module options system,
# not in environment variables. This file documents the module settings
# for reference. Actual values are managed via:
#   - Bitrix24 admin panel: Marketplace → Installed Solutions → MCP Server
#   - CLI: php cli/generate-config.php (from Bitrix environment)
#
# ⚠️  Do NOT commit a real .env file. This is a documentation template only.

# --- Module Settings (stored in Bitrix Option system) ---

# Bearer token for HTTP endpoint authentication.
# Auto-generated on install; regenerate via admin panel or generate-config.php.
# bitrix24_mcp_AUTH_TOKEN=

# Maximum depth for code_search tool recursive scanning (default: 10).
# bitrix24_mcp_MAX_CODE_SEARCH_DEPTH=10

# Maximum number of files scanned per code_search call (default: 1000).
# bitrix24_mcp_MAX_CODE_SEARCH_FILES=1000

# Maximum file size in bytes for file_reader (default: 1048576 = 1 MB).
# bitrix24_mcp_MAX_FILE_SIZE=1048576

# Cache TTL in seconds for module data (default: 3600 = 1 hour).
# bitrix24_mcp_CACHE_TTL=3600

# Enable request/response logging (default: Y).
# bitrix24_mcp_LOG_ENABLED=Y

# --- Cloud REST Adapter (optional, for Bitrix24 Cloud integration) ---
#
# The Cloud adapter is implemented but OAuth authorization-code flow
# and persistent token storage are deferred. Current capabilities:
#   - Webhook-based REST calls
#   - OAuth token exchange (basic)
#
# These settings would apply to the Cloud adapter if fully enabled:
# BITRIX24_CLOUD_PORTAL_URL=https://your-portal.bitrix24.com
# BITRIX24_CLOUD_WEBHOOK_USER_ID=1
# BITRIX24_CLOUD_WEBHOOK_CODE=your-webhook-code

# --- Opt-in integration tests (never used by normal PHPUnit/CI) ---
# Run only with: BITRIX24_RUN_INTEGRATION=1 composer test:integration
# Values belong in an untracked .env or shell environment; do not commit them.
#
# Box: absolute path to the target instance's prolog_before.php.
# BITRIX24_BOX_BOOTSTRAP=/var/www/bitrix/bitrix/modules/main/include/prolog_before.php
#
# Cloud: an inbound-webhook credential with access to the read-only `profile`
# method. OAuth is deliberately not used by this scaffold.
# BITRIX24_CLOUD_PORTAL_URL=https://your-portal.bitrix24.com
# BITRIX24_CLOUD_WEBHOOK_USER_ID=1
# BITRIX24_CLOUD_WEBHOOK_CODE=your-webhook-code
# BITRIX24_CLOUD_TENANT=optional-local-label
